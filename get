#!/usr/bin/env bash
# Online installer/updater for full-setup.
#
# Designed for piping to bash:
#   bash <(curl -s https://raw.githubusercontent.com/n5za/full-setup/master/get)
# Shebang and execute permission are not needed when piped.
#
# Local testing: bash get
#
# Flow:
#   1. Detect distro
#   2. Ensure git is installed
#   3. Pull updates from origin (repo must exist at ~/.cache/full-setup)
#   4. Ensure tools needed by setup (yay on arch)
#   5. Run ./setup.sh

me="-->full-setup<--"
remote_repo=n5za/full-setup
local_path=~/.cache/full-setup
set -e

function try() { "$@" || sleep 0; }
function x() {
  if "$@"; then local cmdstatus=0; else local cmdstatus=1; fi
  while [ "$cmdstatus" == 1 ]; do
    echo -e "\e[31m$me: Command \"\e[32m$@\e[31m\" has failed."
    echo -e "You may need to resolve the problem manually BEFORE repeating this command.\e[0m"
    echo "  r = Repeat this command (DEFAULT)"
    echo "  e = Exit now"
    read -rp " [R/e]: " p
    case $p in
      [eE]) echo -e "\e[34mAlright, will exit.\e[0m"; break ;;
      *) echo -e "\e[34mOK, repeating...\e[0m"
         if "$@"; then local cmdstatus=0; else local cmdstatus=1; fi ;;
    esac
  done
  case $cmdstatus in
    0) echo -e "\e[34m$me: Command \"\e[32m$@\e[34m\" finished.\e[0m" ;;
    1) echo -e "\e[31m$me: Command \"\e[32m$@\e[31m\" has failed. Exiting...\e[0m"; exit 1 ;;
  esac
}

function detect_distro_id() {
  . /etc/os-release 2>/dev/null || { echo "$me: Cannot read /etc/os-release. Aborting..."; exit 1; }
  OS_DISTRO_ID=$ID
  OS_DISTRO_ID_LIKE=$ID_LIKE
  echo "$me: OS_DISTRO_ID: $OS_DISTRO_ID"
  echo "$me: OS_DISTRO_ID_LIKE: $OS_DISTRO_ID_LIKE"
  case "$ID $ID_LIKE" in
    arch*|cachyos*) OS_GROUP_ID=arch ;;
    debian*|ubuntu*) OS_GROUP_ID=debian ;;
    fedora*) OS_GROUP_ID=fedora ;;
    *suse*) OS_GROUP_ID=suse ;;
    *) OS_GROUP_ID= ;;
  esac
}

function auto_install_git() {
  command -v git >/dev/null 2>&1 && return
  echo "$me: Command \"git\" not found, trying to install it..."
  case $OS_GROUP_ID in
    arch)   x sudo pacman -S --noconfirm git ;;
    debian) x sudo apt update -y && x sudo apt install -y git ;;
    fedora) x sudo dnf install -y git ;;
    suse)   x sudo zypper -n install git ;;
    *)      echo "$me: Unsupported distro, install git manually. Aborting..."; exit 1 ;;
  esac
  command -v git >/dev/null 2>&1 || { echo "$me: Failed to install git. Aborting..."; exit 1; }
}

function ensure_yay() {
  [ "$OS_GROUP_ID" = "arch" ] || return 0
  command -v yay >/dev/null 2>&1 && { echo "$me: yay found."; return 0; }
  echo "$me: yay not found, building from AUR..."
  local tmp
  tmp="$(mktemp -d)"
  x git clone --depth=1 https://aur.archlinux.org/yay.git "$tmp/yay"
  cd "$tmp/yay"
  x makepkg -si --noconfirm
  cd "$local_path"
  rm -rf "$tmp"
  command -v yay >/dev/null 2>&1 || { echo "$me: Failed to install yay. Aborting..."; exit 1; }
  echo "$me: yay installed."
}

detect_distro_id
auto_install_git

echo "$me: path to clone: $local_path"
mkdir -p "$local_path"
cd "$local_path"
if [ -z "$(ls -A)" ]; then
  git init -b master
  git remote add origin "https://github.com/$remote_repo"
fi
git remote get-url origin | grep -q "$remote_repo" || {
  echo "Dir \"$local_path\" is not empty, nor a git repo of $remote_repo. Aborting..."
  exit 1
}
x git pull origin master
x git branch --set-upstream-to=origin/master master
echo "$me: Downloaded/Updated."

ensure_yay

echo "$me: Running \"./setup.sh\"."
x ./setup.sh
